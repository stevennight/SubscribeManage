# SubscribeManage Environment Configuration

# JWT Secret - CHANGE THIS in production!
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Default admin credentials (only used on first run)
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=admin123

# Database (SQLite path relative to backend working dir)
DATABASE_URL=sqlite:///./data/subscriptions.db

# Exchange Rate API (optional, leave empty for manual rates)
EXCHANGE_RATE_API_KEY=

# Telegram (optional, configure in web UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone
TIMEZONE=Asia/Shanghai
