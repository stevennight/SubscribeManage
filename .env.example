# SubscribeManage Environment Configuration

# Production images and release version. Use an exact tag, not latest.
SUBSCRIBEMANAGE_BACKEND_IMAGE=ghcr.io/stevennight/subscribemanage-backend
SUBSCRIBEMANAGE_FRONTEND_IMAGE=ghcr.io/stevennight/subscribemanage-frontend
SUBSCRIBEMANAGE_VERSION=v0.1.5
SUBSCRIBEMANAGE_BIND_ADDRESS=127.0.0.1
SUBSCRIBEMANAGE_PORT=3000
SUBSCRIBEMANAGE_BACKEND_BIND_ADDRESS=127.0.0.1
SUBSCRIBEMANAGE_BACKEND_PORT=8000

# JWT Secret - CHANGE THIS in production!
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Default admin credentials (only used on first run)
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=admin123

# Database (SQLite path relative to backend working dir)
DATABASE_URL=sqlite:///./data/subscriptions.db

# Exchange Rate API (optional, leave empty for manual rates)
EXCHANGE_RATE_API_KEY=

# Telegram (optional, configure in web UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone
TIMEZONE=Asia/Shanghai
